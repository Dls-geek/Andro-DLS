[Unit]
Description=DLS Keeper 24/7 (portmap tunnel + payload shell listener)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/div-admin/geek-div/tools-haydra/Andro-DLS
ExecStart=/home/div-admin/.venv/bin/python /home/div-admin/geek-div/tools-haydra/Andro-DLS/modules/keeper.py daemon
Restart=always
RestartSec=5
Environment=DLS_LPORT=4445
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
